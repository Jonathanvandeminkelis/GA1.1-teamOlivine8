   "source": [
    "def multiply(a,b):\n",
    "    return a * b\n",
    "\n",
    "\n",
    "# Example calls\n",
    "print(multiply(8, 5))\n",
    "print(multiply(3, 7))\n",
    "print(multiply(10, 0))\n",
    "\n",
    "\n"
   ]
  },
